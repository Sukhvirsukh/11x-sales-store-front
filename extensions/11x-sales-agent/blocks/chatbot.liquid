{% assign agent_id = app.metafields.chatbot.agent_id.value | strip %}
{% if agent_id == blank %}
  {% assign agent_id = block.settings.agent_id | strip %}
{% endif %}
{% assign agent_id = agent_id | split: '?' | first | split: '#' | first | split: '/' | last | strip %}

{% if agent_id != blank %}
  <script src="https://agent.11xsales.ai/widget.js" data-agent="{{ agent_id | escape }}" defer></script>
{% endif %}

{% schema %}
{
  "name": "Chatbot",
  "target": "body",
  "settings": [
    {
      "type": "paragraph",
      "content": "Your agent is connected automatically during app setup. If it has not been connected yet, enter an Agent ID below."
    },
    {
      "type": "text",
      "id": "agent_id",
      "label": "Agent ID (fallback)",
      "placeholder": "5a3f3f9b-d6a0-4195-a77e-f4751534bcc1",
      "info": "Used only when no agent is connected automatically. Paste an Agent ID or a full agent share link."
    }
  ]
}
{% endschema %}
