# Copy to .env and supply the values of your existing Shopify app.
SHOPIFY_API_KEY=your-app-client-id
SHOPIFY_APP_NAME=11x-sales-agent
SHOPIFY_APP_URL=https://shopify.dev/apps/default-app-home
SHOPIFY_APP_EMBEDDED=true
# Comma-separated OAuth callback URLs; currently none.
SHOPIFY_AUTH_REDIRECT_URLS=
SHOPIFY_WEBHOOK_API_VERSION=2027-01

# Keep the client secret and merchant access tokens in the installation backend.
